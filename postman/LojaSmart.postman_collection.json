          }
        ],
        "url": "{{baseUrl}}/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Smartphone Alpha 128 GB\",\n  \"preco\": 1499.9,\n  \"estoque\": true\n}",
          "options": {
