              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json(); pm.collectionVariables.set('produtoId', data.id);",
              "pm.test('Produto salvo corretamente', () => { pm.expect(data.nome).to.eql('Smartphone Alpha 128 GB'); pm.expect(data.preco).to.eql(1499.90); pm.expect(data.estoque).to.eql(true); pm.expect(data.id).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 POST pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"produtoId\": \"{{produtoId}}\",\n  \"quantidade\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json(); pm.collectionVariables.set('pedidoId', data.id);",
              "pm.test('Pedido com cliente, produto e quantidade corretos', () => { pm.expect(data.clienteId).to.eql(Number(pm.collectionVariables.get('clienteId'))); pm.expect(data.produtoId).to.eql(Number(pm.collectionVariables.get('produtoId'))); pm.expect(data.quantidade).to.eql(2); });"
            ]
          }
        }
      ]
    },
