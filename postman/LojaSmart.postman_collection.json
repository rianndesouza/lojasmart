{
  "info": {
    "name": "LojaSmart - verificacao completa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cria registros de teste, verifica CRUD e validacoes, exclui somente os registros criados nesta execucao e deixa um cadastro demonstrativo ao final."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 POST cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Riann5015630\",\n  \"clienteDesde\": \"2026-11-10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json(); pm.collectionVariables.set('clienteId', data.id);",
              "pm.test('Nome e data corretos', () => { pm.expect(data.nome).to.eql('Riann5015630'); pm.expect(data.clienteDesde).to.eql('2026-11-10'); pm.expect(data.id).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 POST produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
