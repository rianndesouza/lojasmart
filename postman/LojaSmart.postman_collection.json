            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Lista contem o registro cadastrado',()=>{pm.expect(pm.response.json().some(x=>x.id===Number(pm.collectionVariables.get('clienteId')))).to.eql(true);});"
